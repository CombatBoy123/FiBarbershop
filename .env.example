# Copy this file to .env and fill in real values before starting the server.

# Postgres connection string. On Render: create a Postgres database, then copy
# its "Internal Database URL" (for a service in the same region) or "External
# Database URL" (to connect from your own PC). Locally, point it at any
# Postgres instance, e.g.:
#   postgresql://postgres:postgres@localhost:5432/fibarbers
DATABASE_URL=replace_this_with_your_postgres_connection_string

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Port the server listens on. It serves both the API and public/.
PORT=4100

# Comma-separated list of origins allowed to call the API. When the site and
# the API are the same server (the default here) you can leave this as *.
# Example: ALLOWED_ORIGIN=https://kassa.fibarbers.ee
ALLOWED_ORIGIN=*

# Set to "1" to allow public self-registration at /api/register. Left off, the
# only way to create a staff account is `npm run seed-user`, which is what you
# want for a shop: no stranger can register themselves into your books.
ALLOW_PUBLIC_REGISTER=0

# Optional. The shop's timezone: decides what "today" is for sales, cash-book
# entries and stock movements. Defaults to Europe/Tallinn.
# SHOP_TZ=Europe/Tallinn

# Optional: a way back in when nobody can log in. Set BOTH, then restart. On
# start the server makes sure this owner account exists with this password
# (creating it, or resetting the password of the account with that email).
# On Render set them under the service's Environment tab — never commit them.
# Remove them again once you are in: while set, every restart restores this
# password.
# ADMIN_EMAIL=admin@fibarbers.ee
# ADMIN_PASSWORD=a-long-password-only-you-know
# ADMIN_NAME=Fi Barbershop admin
